{
	"name": "@wakamejs/vite",
	"version": "0.0.1-alpha.4",
	"description": "Vite plugin for inserting semantic wbr elements with Wakame",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/umitsukidev/wakame.git",
		"directory": "packages/vite"
	},
	"files": [
		"dist"
	],
	"type": "module",
	"sideEffects": false,
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js",
			"default": "./dist/index.js"
		}
	},
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"build": "tsc -p tsconfig.json",
		"typecheck": "tsc --noEmit -p tsconfig.json"
	},
	"dependencies": {
		"@wakamejs/core": "workspace:*",
		"parse5": "^8.0.1"
	},
	"devDependencies": {
		"vite": "^8.2.2"
	},
	"peerDependencies": {
		"vite": "^7.0.0 || ^8.0.0"
	},
	"engines": {
		"node": ">=20"
	}
}

{
	"name": "@wakamejs/react-rolldown",
	"version": "0.2.1",
	"description": "SSR-safe React Rolldown plugin for inserting semantic zero-width spaces with Wakame",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/umitsukidev/wakame.git",
		"directory": "packages/react-rolldown"
	},
	"files": [
		"dist"
	],
	"type": "module",
	"sideEffects": false,
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js",
			"default": "./dist/index.js"
		}
	},
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"build": "tsc -p tsconfig.json",
		"test": "pnpm build && vitest run",
		"typecheck": "tsc --noEmit -p tsconfig.json"
	},
	"dependencies": {
		"@babel/generator": "^7.29.13",
		"@babel/parser": "^7.29.13",
		"@babel/traverse": "^7.29.13",
		"@babel/types": "^7.29.11",
		"@rolldown/pluginutils": "^1.1.0",
		"@wakamejs/core": "workspace:*"
	},
	"devDependencies": {
		"@types/babel__generator": "^7.27.0",
		"@types/babel__traverse": "^7.28.0",
		"@types/jsdom": "^21.1.7",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"jsdom": "^30.1.3",
		"react": "^19.3.1",
		"react-dom": "^19.3.1",
		"rolldown": "^1.3.1",
		"vite": "^8.3.7",
		"vitest": "^5.1.0"
	},
	"peerDependencies": {
		"rolldown": "^1.0.0"
	},
	"engines": {
		"node": ">=20"
	}
}

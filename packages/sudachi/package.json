{
	"name": "@wakamejs/sudachi",
	"version": "0.0.1-alpha.6",
	"description": "Sudachi tokenizer for Wakame",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/umitsukidev/wakame.git",
		"directory": "packages/sudachi"
	},
	"files": [
		"LICENSE",
		"LICENSE-APACHE-2.0",
		"SUDACHI_DICT_LEGAL",
		"THIRD_PARTY_NOTICES.md",
		"dist",
		"generated/native-binding.js",
		"generated/native-binding.d.ts",
		"assets"
	],
	"type": "module",
	"sideEffects": false,
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js",
			"default": "./dist/index.js"
		}
	},
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"build:native": "napi build --platform --esm --output-dir generated --js native-binding.js --dts native-binding.d.ts --manifest-path rust/Cargo.toml",
		"build:release": "napi build --platform --esm --release --output-dir generated --js native-binding.js --dts native-binding.d.ts --manifest-path rust/Cargo.toml && tsc -p tsconfig.json",
		"build": "pnpm run build:native && tsc -p tsconfig.json",
		"typecheck": "tsc --noEmit -p tsconfig.json"
	},
	"dependencies": {
		"@wakamejs/core": "workspace:*"
	},
	"devDependencies": {
		"@napi-rs/cli": "^3.0.0",
		"@types/node": "^24.0.0"
	},
	"napi": {
		"binaryName": "wakame-sudachi",
		"rootPublisher": "pnpm",
		"targets": [
			"x86_64-unknown-linux-gnu",
			"aarch64-unknown-linux-gnu",
			"x86_64-pc-windows-msvc",
			"aarch64-pc-windows-msvc",
			"aarch64-apple-darwin"
		]
	},
	"engines": {
		"node": ">=20"
	}
}

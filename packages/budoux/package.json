{
	"name": "@wakamejs/budoux",
	"version": "0.2.0",
	"description": "BudouX tokenizer for Wakame",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/umitsukidev/wakame.git",
		"directory": "packages/budoux"
	},
	"files": [
		"dist"
	],
	"type": "module",
	"sideEffects": false,
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js",
			"default": "./dist/index.js"
		},
		"./runtime": {
			"types": "./dist/runtime.d.ts",
			"import": "./dist/runtime.js",
			"default": "./dist/runtime.js"
		}
	},
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"build": "tsc -p tsconfig.json",
		"test": "pnpm build && vitest run",
		"typecheck": "tsc --noEmit -p tsconfig.json"
	},
	"dependencies": {
		"@wakamejs/core": "workspace:*",
		"budoux": "^0.9.2"
	},
	"devDependencies": {
		"vitest": "^5.0.1"
	},
	"engines": {
		"node": ">=20"
	}
}

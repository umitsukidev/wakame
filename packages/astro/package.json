{
	"name": "@wakamejs/astro",
	"version": "0.1.4",
	"description": "Astro integration for inserting semantic wbr elements with Wakame",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/umitsukidev/wakame.git",
		"directory": "packages/astro"
	},
	"files": [
		"dist"
	],
	"type": "module",
	"sideEffects": false,
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js",
			"default": "./dist/index.js"
		}
	},
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"build": "tsc -p tsconfig.json",
		"typecheck": "tsc --noEmit -p tsconfig.json",
		"test": "pnpm --filter @wakamejs/core build && pnpm --filter @wakamejs/vite build && pnpm build && vitest run"
	},
	"dependencies": {
		"@wakamejs/core": "workspace:*",
		"@wakamejs/vite": "workspace:*"
	},
	"devDependencies": {
		"@types/node": "^24.19.2",
		"astro": "^7.4.8",
		"vitest": "^5.1.0"
	},
	"peerDependencies": {
		"astro": "^6.0.0 || ^7.0.0"
	},
	"engines": {
		"node": ">=22.12.0"
	}
}
